---
import { Icon } from "astro-icon/components";
import { WHATSAPP_URL } from "@/lib/contact";
---
<section id="inicio" class="hero page-shell" aria-labelledby="hero-title">
  <div class="hero-copy entrance">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Landing pages e sites institucionais</p>
    <h1 id="hero-title">Seu negócio merece um site <span>à altura.</span></h1>
    <p class="hero-description">Design claro, navegação simples e uma presença digital profissional para apresentar seu negócio e facilitar o próximo contato.</p>
    <div class="hero-actions">
      <a class="action" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer"><Icon name="mdi:whatsapp" class="size-5" /> Solicitar orçamento</a>
      <a class="text-link" href="#projetos">Conhecer projetos <Icon name="mdi:arrow-right" class="size-5" /></a>
    </div>
    <p class="hero-note">Feito com cuidado. Pensado para seus clientes.</p>
  </div>
  <div class="hero-art entrance" aria-hidden="true">
    <div class="browser-preview">
      <div class="browser-bar"><span></span><span></span><span></span><div>seunegocio.com.br</div></div>
      <div class="preview-content">
        <div class="preview-nav"><strong>Sua marca<span>.</span></strong><div>Início &nbsp; Sobre &nbsp; Contato</div></div>
        <div class="preview-label">UMA NOVA PRESENÇA DIGITAL</div>
        <div class="preview-title">Grandes ideias.<br /><span>Novas conexões.</span></div>
        <div class="preview-lines"><span></span><span></span></div>
        <div class="preview-button">Vamos conversar <Icon name="mdi:arrow-top-right" class="size-4" /></div>
        <div class="preview-tiles"><div><Icon name="mdi:lightning-bolt-outline" class="size-6" /><span>Performance</span></div><div><Icon name="mdi:cellphone-link" class="size-6" /><span>Responsividade</span></div><div><Icon name="mdi:creation" class="size-6" /><span>Identidade</span></div></div>
      </div>
    </div>
    <div class="preview-badge"><Icon name="mdi:check-circle" class="size-5" /> Cada detalhe faz diferença.</div>
  </div>
</section>
