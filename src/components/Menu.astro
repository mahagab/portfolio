---
import { Icon } from "astro-icon/components";
import { WHATSAPP_URL } from "@/lib/contact";
const links = [{ href: "#projetos", label: "Projetos" }, { href: "#servicos", label: "Serviços" }, { href: "#sobre", label: "Sobre" }];
---
<header class="site-header">
  <div class="page-shell header-inner">
    <a href="#inicio" class="brand" aria-label="GM codeworks — início"><span class="brand-mark">GM<span aria-hidden="true">.</span></span><span>codeworks</span></a>
    <nav class="desktop-nav" aria-label="Navegação principal">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <a class="action action-small" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer"><Icon name="mdi:whatsapp" class="size-5" /><span>Solicitar orçamento</span></a>
    <nav class="mobile-nav" aria-label="Navegação por seções">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
  </div>
</header>
