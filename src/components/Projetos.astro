---
import directus from "@/lib/directus";
import { readItems } from "@directus/sdk";
import ProjectCard from "@/components/ProjectCard.astro";

const projetos = await directus.request(
  readItems("projects", {
    fields: ["slug", "title", "Image", "description", "link", { categorie: ["title"] }],
  })
);

---

<section id="projetos" class="page-shell section-space" aria-labelledby="projects-title"> 
  <p class="eyebrow">Trabalho em destaque</p>
  <h2 id="projects-title" class="section-title mb-3">Projetos selecionados</h2>
  <span class="text-gray-500">Alguns exemplos de sites desenvolvidos com foco em resultados.</span>

  <div class="grid grid-cols-1 mt-8 gap-7 md:grid-cols-2">
    {projetos.map((projeto) => (
      <ProjectCard projeto={projeto} />
    ))}
  </div>

  {projetos.length === 0 && <p>Nenhum projeto encontrado.</p>}

</section>
