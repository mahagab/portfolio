---
import { Icon } from "astro-icon/components";
import { Card, CardContent, CardFooter, CardMedia } from "@/components/ui/card";
interface Props {
  projeto: {
    title: string;
    slug: string;
    description: string;
    Image?: string | null;
    categorie?: { title: string } | null;
    link?: string | null;
  };
}
const { projeto } = Astro.props;
const baseUrl = import.meta.env.PUBLIC_DIRECTUS_URL;
const imageUrl = projeto.Image ? new URL(`assets/${encodeURIComponent(projeto.Image)}?width=900&quality=85`, `${baseUrl.replace(/\/+$/, "")}/`).href : null;
// Apenas destinos HTTP(S) são aceitos para os links cadastrados no CMS.
let projectUrl: string | undefined;
try {
  const url = new URL(projeto.link ?? "");
  if (["https:", "http:"].includes(url.protocol)) projectUrl = url.href;
} catch { /* O projeto pode não ter um link público. */ }
---
<article class="project-card">
  <Card class="h-full">
    {imageUrl && <CardMedia class="aspect-[16/10] rounded-none"><img src={imageUrl} alt={`Prévia do projeto ${projeto.title}`} width="900" height="563" loading="lazy" decoding="async" /></CardMedia>}
    <CardContent>
      <h3 class="text-xl font-bold">{projeto.title}</h3>
      <p class="mt-3 text-gray-600 leading-relaxed">{projeto.description}</p>
    </CardContent>
    <CardFooter class="mt-auto flex flex-wrap items-center justify-between gap-4">
      {projeto.categorie?.title && <span class="project-category">{projeto.categorie.title}</span>}
      {projectUrl && <a class="text-link" href={projectUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visitar projeto ${projeto.title} (abre em nova aba)`}>Visitar projeto <Icon name="mdi:arrow-top-right" class="size-4" /></a>}
    </CardFooter>
  </Card>
</article>
